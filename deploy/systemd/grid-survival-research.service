[Unit]
Description=Grid Survival Research Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/grid-survival-research
ExecStartPre=/usr/bin/docker compose run --rm shadow-037-preflight
ExecStart=/usr/bin/docker compose up -d collector-btcusdt-klines collector-btcusdt-futures-klines collector-btcusdt-futures-depth shadow-runner-037
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
