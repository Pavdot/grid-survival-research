[Unit]
Description=Grid Survival Research Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/grid-survival-research
ExecStart=/usr/bin/docker compose up -d collector-btcusdt-depth collector-btcusdt-klines
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
